{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(python3 -m unittest*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Edit(./arkiv/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_python_json_syntax.py\""
          }
        ]
      }
    ]
  }
}